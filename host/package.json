{
  "name": "all-tools-host",
  "version": "0.3.0",
  "description": "All-Tools 本地工具集线器宿主",
  "main": "./out/main/index.js",
  "author": "all-tools",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "fetch-node": "node scripts/fetch-node.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "dist": "npm run gen-icon && npm run fetch-node && npm run build && electron-builder",
    "dist:dir": "npm run gen-icon && npm run fetch-node && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
